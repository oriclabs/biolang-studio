{
  "name": "biolang-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "prebuild": "npm run sync:runtime",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:live": "node scripts/smoke-live.mjs",
    "test:native": "node scripts/native-desktop-smoke.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  }
}
